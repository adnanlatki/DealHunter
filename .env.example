# Copy these into Vercel > Project > Settings > Environment Variables
# (or into a file called .env.local if running on your own computer)

# --- OpenAI (platform.openai.com/api-keys) ---
OPENAI_API_KEY=sk-...

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # the "anon public" key
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # the "service_role" key. SECRET.

# --- Who may log in to the dashboard (your email, same as the Supabase user you create) ---
ADMIN_EMAILS=you@example.com

# --- Meta WhatsApp Cloud API ---
WHATSAPP_TOKEN=EAAG...                          # permanent System User token
PHONE_NUMBER_ID=123456789012345                 # from Meta > WhatsApp > API Setup
WHATSAPP_VERIFY_TOKEN=make-up-a-long-random-word  # you invent this; paste the same in Meta
WHATSAPP_APP_SECRET=abcdef123456                # Meta > App settings > Basic > App secret

# --- Protects the hourly/daily cleanup job (make up a long random word) ---
CRON_SECRET=make-up-another-long-random-word

# ===================== OPTIONAL (plug-and-play slots, leave empty until you connect them) =====================
# Turn the public website on/off (default on). Set to false to hide it.
PUBLIC_SITE_ENABLED=true

# Texnity / any third-party messaging platform. See INTEGRATIONS.md
TEXNITY_WEBHOOK_SECRET=
TEXNITY_REPLY_MODE=inline        # inline = platform sends our reply, push = we call TEXNITY_SEND_URL
TEXNITY_SEND_URL=
TEXNITY_API_KEY=

# Instagram DMs. See INTEGRATIONS.md
INSTAGRAM_TOKEN=
INSTAGRAM_VERIFY_TOKEN=          # optional, falls back to WHATSAPP_VERIFY_TOKEN
INSTAGRAM_APP_SECRET=            # optional, falls back to WHATSAPP_APP_SECRET
